rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public CMS settings - anyone can read landing page CMS
    match /settings/cms {
      allow read, write: if true;
    }

    // Admin credentials setting
    match /settings/adminCredentials {
      allow read, write: if true;
    }

    // Catch-all settings documents
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Santri collection - allow list and document get/write
    match /santris/{santriId} {
      allow read, write: if true;
    }

    // Guru collection - allow list and document get/write
    match /gurus/{guruId} {
      allow read, write: if true;
    }

    // Absensi collection - allow list and document get/write
    match /absensis/{absensiId} {
      allow read, write: if true;
    }

    // Pelanggaran collection - allow list and document get/write
    match /pelanggarans/{pelanggaranId} {
      allow read, write: if true;
    }

    // Messages collection - allow list and document get/write
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Test connection document for verifying Firestore connectivity on boot
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
